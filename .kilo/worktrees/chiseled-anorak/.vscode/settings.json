{
  // Use the in-project venv so imports (markitdown, pydantic) resolve
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // Test discovery: show all 22 tests in the Testing panel
  "python.testing.pytestArgs": ["tests"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  // Ensure Explorer shows everything
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  // Keep the file watcher light: prevents watcher memory blowups
  // (seen as "Cannot allocate memory" + ptyHost heartbeat loss in server logs)
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/node_modules/**": true,
    "**/.git/objects/**": true
  }
}
